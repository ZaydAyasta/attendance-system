meta {
  name: Get employee absence history
  type: http
  seq: 6
  tags: [
    Absences
  ]
}

get {
  url: {{baseUrl}}/api/employees/:employeeId/absences
  body: none
  auth: inherit
}

params:path {
  employeeId: {{employeeId}}
}

docs {
  Returns the absence history registered for a specific employee.
}


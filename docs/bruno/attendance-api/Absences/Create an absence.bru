meta {
  name: Create an absence
  type: http
  seq: 2
  tags: [
    Absences
  ]
}

post {
  url: {{baseUrl}}/api/absences
  body: json
  auth: inherit
}

body:json {
  {
    "employeeId": "{{employeeId}}",
    "startDate": "{{fromDate}}",
    "endDate": "{{toDate}}",
    "type": "Vacation",
    "reason": "Vacation example created from Bruno",
    "notes": "Replace dates and type as needed"
  }
}

docs {
  Registers a new absence for an employee.
}

example {
  name: 201 Response
  description: Created
  
  request: {
    url: {{baseUrl}}/api/absences
    method: POST
    mode: json
    body:json: {
      {
        "employeeId": "",
        "startDate": "",
        "endDate": "",
        "type": "",
        "reason": "",
        "notes": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "",
          "employeeId": "",
          "startDate": "",
          "endDate": "",
          "type": "",
          "status": "",
          "reason": "",
          "notes": "",
          "version": ""
        }
      '''
    }
  }
}


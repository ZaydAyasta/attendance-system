meta {
  name: Update an absence
  type: http
  seq: 4
  tags: [
    Absences
  ]
}

put {
  url: {{baseUrl}}/api/absences/:id
  body: json
  auth: inherit
}

params:path {
  id: {{absenceId}}
}

body:json {
  {
    "startDate": "{{fromDate}}",
    "endDate": "{{toDate}}",
    "type": "Permission",
    "reason": "Updated example from Bruno",
    "notes": "Use the current version returned by GET before sending",
    "version": 1
  }
}

docs {
  Updates an existing absence while preserving optimistic concurrency checks.
}


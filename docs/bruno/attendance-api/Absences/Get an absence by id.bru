meta {
  name: Get an absence by id
  type: http
  seq: 3
  tags: [
    Absences
  ]
}

get {
  url: {{baseUrl}}/api/absences/:id
  body: none
  auth: inherit
}

params:path {
  id: {{absenceId}}
}

docs {
  Returns a single absence record by its identifier.
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/absences/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "",
          "employeeId": "",
          "startDate": "",
          "endDate": "",
          "type": "",
          "status": "",
          "reason": "",
          "notes": "",
          "version": ""
        }
      '''
    }
  }
}


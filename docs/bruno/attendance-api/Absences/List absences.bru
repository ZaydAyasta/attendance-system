meta {
  name: List absences
  type: http
  seq: 1
  tags: [
    Absences
  ]
}

get {
  url: {{baseUrl}}/api/absences
  body: none
  auth: inherit
}

params:query {
  ~employeeId: {{employeeId}}
  ~from: {{fromDate}}
  ~to: {{toDate}}
  ~status: Active
  ~type: Vacation
}

docs {
  Returns absences filtered by optional employee, date range, status and type criteria.
  Example values:
  - status: Active, Cancelled
  - type: Vacation, MedicalLeave, Commission, JustifiedAbsence, Permission
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/absences
    method: GET
    mode: none
    params:query: {
      ~employeeId: 
      ~from: 
      ~to: 
      ~status: 
      ~type: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "id": "",
            "employeeId": "",
            "startDate": "",
            "endDate": "",
            "type": "",
            "status": "",
            "reason": "",
            "notes": "",
            "version": ""
          }
        ]
      '''
    }
  }
}

example {
  name: 400 Response
  description: Bad Request
  
  request: {
    url: {{baseUrl}}/api/absences
    method: GET
    mode: none
    params:query: {
      ~employeeId: 
      ~from: 
      ~to: 
      ~status: 
      ~type: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "",
          "title": "",
          "status": "",
          "detail": "",
          "instance": "",
          "errors": {}
        }
      '''
    }
  }
}

meta {
  name: Cancel an absence
  type: http
  seq: 5
  tags: [
    Absences
  ]
}

post {
  url: {{baseUrl}}/api/absences/:id/cancel
  body: json
  auth: inherit
}

params:path {
  id: {{absenceId}}
}

body:json {
  {
    "version": 1
  }
}

docs {
  Cancels an existing absence using optimistic concurrency.
}


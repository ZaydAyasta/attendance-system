  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/work-calendar/:date
    method: PUT
    mode: json
    params:path: {
      date: 
    }
  
    body:json: {
      {
        "dayType": "",
        "description": "",
        "version": ""
      }
    }
  }
  
  response: {

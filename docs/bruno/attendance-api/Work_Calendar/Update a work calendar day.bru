meta {
  name: Update a work calendar day
  type: http
  seq: 4
  tags: [
    Work_Calendar
  ]
}

put {
  url: {{baseUrl}}/api/work-calendar/:date
  body: json
  auth: inherit
}

params:path {
  date: {{calendarDate}}
}

body:json {
  {
    "dayType": "Holiday",
    "description": "Example update from Bruno",
    "version": 1
  }
}

docs {
  Updates the labor classification or description of an existing work calendar entry.
}


meta {
  name: Delete a work calendar day
  type: http
  seq: 5
  tags: [
    Work_Calendar
  ]
}

delete {
  url: {{baseUrl}}/api/work-calendar/:date
  body: none
  auth: inherit
}

params:path {
  date: {{calendarDate}}
}

docs {
  Deletes an existing work calendar entry for the specified date.
}


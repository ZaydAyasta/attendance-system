meta {
  name: Get a work calendar day
  type: http
  seq: 3
  tags: [
    Work_Calendar
  ]
}

get {
  url: {{baseUrl}}/api/work-calendar/:date
  body: none
  auth: inherit
}

params:path {
  date: {{calendarDate}}
}

docs {
  Returns the labor classification configured for a specific calendar date.
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/work-calendar/:date
    method: GET
    mode: none
    params:path: {
      date: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "date": "",
          "dayType": "",
          "description": "",
          "version": ""
        }
      '''
    }
  }
}


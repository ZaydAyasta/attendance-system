meta {
  name: Create a work calendar day
  type: http
  seq: 2
  tags: [
    Work_Calendar
  ]
}

post {
  url: {{baseUrl}}/api/work-calendar
  body: json
  auth: inherit
}

body:json {
  {
    "date": "{{calendarDate}}",
    "dayType": "WorkingDay",
    "description": "Regular working day example from Bruno"
  }
}

docs {
  Creates a work calendar entry for a specific date.
}

example {
  name: 201 Response
  description: Created
  
  request: {
    url: {{baseUrl}}/api/work-calendar
    method: POST
    mode: json
    body:json: {
      {
        "date": "",
        "dayType": "",
        "description": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "date": "",
          "dayType": "",
          "description": "",
          "version": ""
        }
      '''
    }
  }
}


    url: {{baseUrl}}/api/employees/:employeeId/attendance
    method: GET
    mode: none
    params:query: {
      ~from: {{fromDate}}
      ~to: {{toDate}}
    }
  
    params:path: {
      employeeId: {{employeeId}}
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}


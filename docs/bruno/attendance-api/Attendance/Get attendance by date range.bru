meta {
  name: Get attendance by date range
  type: http
  seq: 2
  tags: [
    Attendance
  ]
}

get {
  url: {{baseUrl}}/api/employees/:employeeId/attendance
  body: none
  auth: inherit
}

params:query {
  ~from: {{fromDate}}
  ~to: {{toDate}}
}

params:path {
  employeeId: {{employeeId}}
}

docs {
  Returns one evaluated attendance result per day for the requested inclusive range.
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/employees/:employeeId/attendance
    method: GET
    mode: none
    params:query: {
      ~from: {{fromDate}}
      ~to: {{toDate}}
    }
  
    params:path: {
      employeeId: {{employeeId}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "employeeId": "{{employeeId}}",
          "from": "{{fromDate}}",
          "to": "{{toDate}}",
          "days": [
            {
              "employeeId": "{{employeeId}}",
              "date": "{{fromDate}}",
              "status": "Present",
              "anomalies": [],
              "failure": null,
              "grossMinutes": 600,
              "lunchMinutes": 60,
              "workedMinutes": 540,
              "timeCalculationComplete": true,
              "timeIssues": []
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Bad Request
  
  request: {
    url: {{baseUrl}}/api/employees/:employeeId/attendance
    method: GET
    mode: none
    params:query: {
      ~from: invalid-date
      ~to: {{toDate}}
    }
  
    params:path: {
      employeeId: {{employeeId}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "",
          "title": "",
          "status": "",
          "detail": "",
          "instance": "",
          "errors": {}
        }
      '''
    }
  }
}


meta {
  name: Get attendance by date range
  type: http
  seq: 2
  tags: [
    Attendance
  ]
}

get {
  url: {{baseUrl}}/api/employees/:employeeId/attendance
  body: none
  auth: inherit
}

params:query {
  ~from: {{fromDate}}
  ~to: {{toDate}}
}

params:path {
  employeeId: {{employeeId}}
}

docs {
  Returns one evaluated attendance result per day for the requested inclusive range.
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/employees/:employeeId/attendance
    method: GET
    mode: none
    params:query: {
      ~from: 
      ~to: 
    }
  
    params:path: {
      employeeId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "employeeId": "",
          "from": "",
          "to": "",
          "days": [
            {
              "employeeId": "",
              "date": "",
              "status": "",
              "anomalies": [],
              "failure": ""
            }
          ]
        }
      '''
    }
  }
}


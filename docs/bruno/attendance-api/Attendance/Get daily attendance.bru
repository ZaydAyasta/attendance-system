meta {
  name: Get daily attendance
  type: http
  seq: 1
  tags: [
    Attendance
  ]
}

get {
  url: {{baseUrl}}/api/employees/:employeeId/attendance/:date
  body: none
  auth: inherit
}

params:path {
  employeeId: {{employeeId}}
  date: {{attendanceDate}}
}

docs {
  Returns the daily attendance evaluation for a specific employee and date.
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/employees/:employeeId/attendance/:date
    method: GET
    mode: none
    params:path: {
      employeeId: 
      date: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "employeeId": "",
          "date": "",
          "status": "",
          "anomalies": [],
          "failure": ""
        }
      '''
    }
  }
}


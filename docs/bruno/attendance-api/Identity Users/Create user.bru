meta {
  name: Create identity user
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/identity/users
  body: json
}

headers {
  X-CSRF-TOKEN: {{csrfToken}}
}

body:json {
  {
    "username": "new-user",
    "email": null,
    "password": "{{initialPassword}}",
    "role": "User",
    "employeeId": "{{employeeId}}"
  }
}
